module nlayers_ndata_eg_alg_mod
  implicit none
contains
  subroutine my_alg()
    use constants_mod, only: r_def
    use field_mod, only: field_type
    use testkern_nlayers_ndata_mod, only: testkern_nlayers_ndata_type
    implicit none
    real(kind=r_def) :: scalar
    type(field_type) :: fld1, fld2, fld3, fld4, fld5, fld6

    call invoke( &
       testkern_nlayers_ndata_type(scalar, fld1, fld2, fld3, fld4, fld5, fld6) )
  end subroutine my_alg
end module
